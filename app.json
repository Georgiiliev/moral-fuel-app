{
  "expo": {
    "name": "Moral Fuel",
    "slug": "moral-fuel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moralfuel",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F4ED",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.moralfuel.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F4ED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.moralfuel.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4ED",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#121815",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      ["expo-notifications", { "enableRemoteNotifications": false }],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.moralfuel.app",
          "widgets": [
            {
              "name": "DailyInspiration",
              "displayName": "Dagelijkse inspiratie",
              "description": "Elke dag een Bijbelgedeelte in eigen woorden, met de bijbehorende tekstverwijzing.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "./src/widgets/daily-inspiration.tsx",
                "configuration": {
                  "title": "Inspiratie",
                  "description": "Kies een thema voor deze widget.",
                  "parameters": {
                    "theme": {
                      "title": "Thema",
                      "type": "enum",
                      "values": [
                        {
                          "name": "Alle thema’s",
                          "value": "all"
                        },
                        {
                          "name": "Vertrouwen",
                          "value": "trust"
                        },
                        {
                          "name": "Hoop",
                          "value": "hope"
                        },
                        {
                          "name": "Liefde",
                          "value": "love"
                        },
                        {
                          "name": "Vergeving",
                          "value": "forgiveness"
                        },
                        {
                          "name": "Dankbaarheid",
                          "value": "gratitude"
                        },
                        {
                          "name": "Rust en moed",
                          "value": "peace"
                        },
                        {
                          "name": "Geloof in het dagelijks leven",
                          "value": "everyday"
                        }
                      ],
                      "default": "all"
                    }
                  }
                }
              }
            },
            {
              "name": "JourneyProgress",
              "displayName": "Je reis",
              "description": "Hoeveel lessen je hebt afgerond en wat de volgende les is.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "./src/widgets/journey-progress.tsx"
              }
            },
            {
              "name": "TodayAction",
              "displayName": "Om te doen vandaag",
              "description": "Eén concrete stap uit je huidige les, als uitnodiging.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "./src/widgets/today-action.tsx"
              }
            },
            {
              "name": "Dashboard",
              "displayName": "Moral Fuel vandaag",
              "description": "Inspiratie, je plek in de reis en je stap voor vandaag.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "./src/widgets/dashboard.tsx"
              }
            },
            {
              "name": "LockScreen",
              "displayName": "Moral Fuel",
              "description": "Een korte inspiratie of, als je dat toestaat, je voortgang op het toegangsscherm.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/lock-screen.tsx",
                "configuration": {
                  "title": "Toegangsscherm",
                  "description": "Kies wat deze widget toont.",
                  "parameters": {
                    "content": {
                      "title": "Toon",
                      "type": "enum",
                      "values": [
                        {
                          "name": "Inspiratie",
                          "value": "inspiration"
                        },
                        {
                          "name": "Voortgang",
                          "value": "progress"
                        }
                      ],
                      "default": "inspiration"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
